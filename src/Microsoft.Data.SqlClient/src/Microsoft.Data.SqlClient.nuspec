<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <!-- iplus fork: package id prefixed with "iPlus." (assembly names stay unchanged,
         like the Avalonia fork). Set with the same convention as Avalonia's
         SharedVersion.props IPlusPackageIdPrefix. -->
    <id>iPlus.Microsoft.Data.SqlClient</id>
    <version>$Version$</version>
    <title>iPlus.Microsoft.Data.SqlClient</title>
    <authors>iPlus</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/iplus-framework/SqlClient/</projectUrl>
    <icon>dotnet.png</icon>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/iplus-framework/SqlClient/" commit="$COMMITID$" />
    <description>iPlus fork of Microsoft.Data.SqlClient - the current data provider for SQL Server and Azure SQL databases, with iPlus-specific modifications (browser/WASM WebSocket and HTTP-sync tunnel transports, Tunnel URL connection-string keyword). Based on dotnet/SqlClient with the assembly names unchanged.

      Commonly Used Types:
      Microsoft.Data.SqlClient.SqlConnection
      Microsoft.Data.SqlClient.SqlException
      Microsoft.Data.SqlClient.SqlParameter
      Microsoft.Data.SqlClient.SqlDataReader
      Microsoft.Data.SqlClient.SqlCommand
      Microsoft.Data.SqlClient.SqlTransaction
      Microsoft.Data.SqlClient.SqlParameterCollection
      Microsoft.Data.SqlClient.SqlClientFactory

      When using NuGet 3.x this package requires at least version 3.4.</description>
    <releaseNotes>https://github.com/iplus-framework/SqlClient/releases</releaseNotes>
    <copyright>Copyright 2013-2026 &#169; Microsoft Corporation; iPlus fork modifications</copyright>
    <tags>sqlclient microsoft.data.sqlclient iplus</tags>

    <!--
      Dependency versions are materialized before dotnet pack runs. They may be
      supplied explicitly by the caller or resolved from the sibling Versions.props
      fallback used by the SqlClient pack flow.

      iplus fork: the fork builds net10.0 + net10.0-browser only; the older TFM
      groups (net462/net8.0/net9.0/netstandard2.0) from upstream were removed
      together with their lib/ref/runtimes file entries. Sibling package ids are
      prefixed with "iPlus." like the main package.
    -->

    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Bcl.Cryptography" version="9.0.18" />
        <!-- Native SNI for desktop platforms (Windows). Must NOT be in the browser group. -->
        <dependency id="Microsoft.Data.SqlClient.SNI.runtime" version="7.1.0" />
        <dependency id="iPlus.Microsoft.Data.SqlClient.Extensions.Abstractions" version="$SqlClientVersionRange$" />
        <dependency id="iPlus.Microsoft.Data.SqlClient.Internal.Logging" version="$SqlClientVersionRange$" />
        <dependency id="Microsoft.Extensions.Caching.Memory" version="9.0.18" exclude="Compile" />
        <dependency id="Microsoft.IdentityModel.JsonWebTokens" version="8.16.0" />
        <dependency id="Microsoft.IdentityModel.Protocols.OpenIdConnect" version="8.16.0" />
        <dependency id="iPlus.Microsoft.SqlServer.Server" version="$SqlServerVersionRange$" />
        <dependency id="System.Configuration.ConfigurationManager" version="9.0.18" exclude="Compile" />
        <dependency id="System.Security.Cryptography.Pkcs" version="9.0.18" />
        <dependency id="System.Threading.RateLimiting" version="9.0.18" />
      </group>
      <group targetFramework="net10.0-browser1.0">
        <dependency id="Microsoft.Bcl.Cryptography" version="9.0.18" />
        <dependency id="iPlus.Microsoft.Data.SqlClient.Extensions.Abstractions" version="$SqlClientVersionRange$" />
        <dependency id="iPlus.Microsoft.Data.SqlClient.Internal.Logging" version="$SqlClientVersionRange$" />
        <dependency id="Microsoft.Extensions.Caching.Memory" version="9.0.18" exclude="Compile" />
        <dependency id="Microsoft.IdentityModel.JsonWebTokens" version="8.16.0" />
        <dependency id="Microsoft.IdentityModel.Protocols.OpenIdConnect" version="8.16.0" />
        <dependency id="iPlus.Microsoft.SqlServer.Server" version="$SqlServerVersionRange$" />
        <dependency id="System.Configuration.ConfigurationManager" version="9.0.18" exclude="Compile" />
        <dependency id="System.Security.Cryptography.Pkcs" version="9.0.18" />
        <dependency id="System.Threading.RateLimiting" version="9.0.18" />
      </group>
    </dependencies>

    <references>
      <group targetFramework="net10.0">
        <reference file="Microsoft.Data.SqlClient.dll" />
        <reference file="Microsoft.Data.SqlClient.xml" />
      </group>
      <group targetFramework="net10.0-browser1.0">
        <reference file="Microsoft.Data.SqlClient.dll" />
        <reference file="Microsoft.Data.SqlClient.xml" />
      </group>
    </references>
  </metadata>
  <files>
    <file src="..\tools\icons\dotnet.png" target="" />
    <file src="..\src\Microsoft.Data.SqlClient\src\PackageReadme.md" target="README.md" />

    <!--
      All file paths are relative to the artifacts directory created by the build, so
      the pack flow sets NuspecBasePath to that artifacts directory.

      The pack flow supplies $ReferenceType$ to indicate which build output layout
      should be packaged.

      iplus fork: the real implementation is packed into lib/ for both target
      frameworks (there are no PNSE stub builds for net10.0/net10.0-browser in the
      fork, and the browser TFM must never be a stub). The same managed binary is
      correct for every RID - the native SNI comes from the SNI packages on
      desktop/platforms and does not exist on browser.
    -->

    <!-- Lib Binaries ================================================== -->
    <!-- lib/net10.0 - the real implementation -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\Microsoft.Data.SqlClient.dll" target="lib\net10.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\Microsoft.Data.SqlClient.pdb" target="lib\net10.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\Microsoft.Data.SqlClient.xml" target="lib\net10.0\" exclude="" />

    <!-- lib/net10.0 Localized Resources -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\cs\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\cs\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\de\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\de\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\es\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\es\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\fr\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\fr\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\it\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\it\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\ja\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\ja\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\ko\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\ko\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\pl\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\pl\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\pt-BR\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\pt-BR\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\ru\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\ru\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\tr\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\tr\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\zh-Hans\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\zh-Hans\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0\zh-Hant\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0\zh-Hant\" exclude="" />

    <!-- lib/net10.0-browser - the real implementation incl. the browser transports -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\Microsoft.Data.SqlClient.dll" target="lib\net10.0-browser1.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\Microsoft.Data.SqlClient.pdb" target="lib\net10.0-browser1.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\Microsoft.Data.SqlClient.xml" target="lib\net10.0-browser1.0\" exclude="" />

    <!-- lib/net10.0-browser Localized Resources -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\cs\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\cs\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\de\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\de\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\es\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\es\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\fr\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\fr\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\it\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\it\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\ja\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\ja\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\ko\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\ko\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\pl\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\pl\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\pt-BR\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\pt-BR\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\ru\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\ru\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\tr\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\tr\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\zh-Hans\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\zh-Hans\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net10.0-browser\zh-Hant\Microsoft.Data.SqlClient.resources.dll" target="lib\net10.0-browser1.0\zh-Hant\" exclude="" />

    <!-- Ref Binaries ================================================== -->
    <!-- ref/net10.0 -->
    <file src="Microsoft.Data.SqlClient.ref\$ReferenceType$-$Configuration$\net10.0\Microsoft.Data.SqlClient.dll" target="ref\net10.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient.ref\$ReferenceType$-$Configuration$\net10.0\Microsoft.Data.SqlClient.xml" target="ref\net10.0\" exclude="" />

    <!-- ref/net10.0-browser -->
    <file src="Microsoft.Data.SqlClient.ref\$ReferenceType$-$Configuration$\net10.0-browser\Microsoft.Data.SqlClient.dll" target="ref\net10.0-browser1.0\" exclude="" />
    <file src="Microsoft.Data.SqlClient.ref\$ReferenceType$-$Configuration$\net10.0-browser\Microsoft.Data.SqlClient.xml" target="ref\net10.0-browser1.0\" exclude="" />
  </files>
</package>
