<Project Sdk="Microsoft.NET.Sdk">
  <!-- General Properties ============================================== -->
  <PropertyGroup>
    <AssemblyName>Microsoft.SqlServer.Server</AssemblyName>
    <TargetFrameworks>net46;netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <!-- XML Documentation =============================================== -->
  <!--
    The public types carry documentation comments whose text comes from doc/snippets.  Generating
    the documentation file ships that text with the package, so consumers get IntelliSense for
    them; without it the comments are compiled away and never reach anyone.

    Deliberately unconditional.  The net46 target consists of type forwarders, so its documentation
    file has no members in it, but keeping the setting free of a TargetFramework condition means
    the project gives one unambiguous answer to whether it produces documentation.

    IncludesDocumentationSnippets opts this project into the compile inputs declared in
    src/Directory.Build.targets, so editing one of those snippets rebuilds the documentation file.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludesDocumentationSnippets>true</IncludesDocumentationSnippets>
  </PropertyGroup>

  <!-- Versioning ====================================================== -->
  <!-- Import our Versions.props unless it was already imported (e.g. by Directory.Packages.props
       in Package mode).  The guard property inside Versions.props makes this a no-op on the
       second import. -->
  <Import Project="Versions.props" Condition="'$(SqlServerVersionsImported)' != 'true'" />
  <PropertyGroup>
    <AssemblyVersion>$(SqlServerAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SqlServerFileVersion)</FileVersion>
    <Version>$(SqlServerPackageVersion)</Version>
  </PropertyGroup>

  <!-- Strong name signing ============================================= -->
  <!-- This is done in Directory.Build.props -->

  <!-- Build Output ==================================================== -->
  <PropertyGroup>
    <ArtifactPath>$(RepoRoot)artifacts/</ArtifactPath>
    <OutputPath>$(ArtifactPath)$(AssemblyName)/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <!-- NuGet Package Config ============================================ -->
  <!-- See: https://learn.microsoft.com/en-us/nuget/reference/msbuild-targets#pack-target -->
  <PropertyGroup>
    <!-- iplus fork: package id prefixed with "iPlus." (assembly name unchanged) -->
    <PackageId>iPlus.$(AssemblyName)</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Title>iPlus.Microsoft.SqlServer.Server</Title>
    <Authors>iPlus</Authors>
    <Company>iPlus</Company>
    <Description>iPlus fork of the Microsoft.SqlServer.Server helper library for Microsoft.Data.SqlClient enabling cross framework support of UDT types. Based on dotnet/SqlClient with iPlus-specific modifications.

Available Types:
Microsoft.SqlServer.Server.IBinarySerializer
Microsoft.SqlServer.Server.InvalidUdtException
Microsoft.SqlServer.Server.SqlFacetAttribute
Microsoft.SqlServer.Server.SqlFunctionAttribute
Microsoft.SqlServer.Server.SqlMethodAttribute
Microsoft.SqlServer.Server.SqlUserDefinedAggregateAttribute
Microsoft.SqlServer.Server.SqlUserDefinedTypeAttribute
Microsoft.SqlServer.Server.DataAccessKind
Microsoft.SqlServer.Server.SystemDataAccessKind
Microsoft.SqlServer.Server.Format</Description>
    <Copyright>Copyright 2013-2026 © Microsoft Corporation; iPlus fork modifications</Copyright>
    <PackageTags>sqlserver microsoft.sqlserver.server iplus</PackageTags>
    <PackageReleaseNotes>https://github.com/iplus-framework/SqlClient/releases</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dotnet/SqlClient</RepositoryUrl>
    <PackageProjectUrl>https://aka.ms/sqlclientproject</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>dotnet.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)/tools/icons/dotnet.png" Pack="true" PackagePath="/" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- CodeGen Targets ================================================= -->
  <PropertyGroup>
    <!-- This is backwards compatibility only - @TODO: We should assess whether we actually need it in System or it can default to the assembly namespace -->
  </PropertyGroup>
  <Import Project="$(ToolsDir)targets\GenerateThisAssemblyCs.targets" />
</Project>
